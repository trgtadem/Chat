rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // chatId format: uid1_uid2 (siralanmis uid'ler)
    function isChatParticipant(chatId) {
      return request.auth != null && (request.auth.uid in chatId.split('_'));
    }

    // Sohbetteki karsi tarafin uid'i
    function chatOtherUid(chatId) {
      let ids = chatId.split('_');
      return ids[0] == request.auth.uid ? ids[1] : ids[0];
    }

    // Mesajlasma yalnizca arkadaslar arasinda
    function areFriends(chatId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(chatOtherUid(chatId)));
    }

    function isBlocked(chatId) {
      return request.auth != null && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocks/$(chatOtherUid(chatId)))
        || exists(/databases/$(database)/documents/users/$(chatOtherUid(chatId))/blocks/$(request.auth.uid))
      );
    }

    function canChat(chatId) {
      return isChatParticipant(chatId) && areFriends(chatId) && !isBlocked(chatId);
    }

    // Kod -> uid eslemesi (yalnizca kodu bilen okur)
    match /friendCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null && request.auth.uid == userId;

      allow delete: if request.auth != null && request.auth.uid == userId;

      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'surname', 'avatar', 'about', 'online', 'lastSeen', 'pushToken', 'friendCode']);

      match /userChats/{chatPartnerId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && (request.auth.uid == userId || request.auth.uid == chatPartnerId);
      }

      // Gelen arkadaslik istekleri
      match /friendRequests/{fromUid} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == fromUid
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid == userId
          && request.resource.data.status == 'pending';
        allow update, delete: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == fromUid);
      }

      // Gonderilen istekler (bekliyor gostergesi)
      match /sentRequests/{toUid} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.toUid == toUid;
        allow update, delete: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == toUid);
      }

      // Arkadas listesi
      match /friends/{friendUid} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, delete: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == friendUid);
        allow update: if false;
      }

      // Engellenen kullanicilar
      match /blocks/{blockedUid} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /chats/{chatId} {
      allow read, write: if canChat(chatId);

      match /messages/{messageId} {
        allow read: if canChat(chatId);

        allow create: if canChat(chatId)
          && request.resource.data.senderId == request.auth.uid;

        allow update: if canChat(chatId) && (
          (resource.data.senderId != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
          ||
          (resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isDeleted']))
        );

        allow delete: if false;
      }
    }
  }
}
