rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isChatParticipant(chatId) {
      return request.auth != null && (request.auth.uid in chatId.split('_'));
    }

    function chatOtherUid(chatId) {
      let ids = chatId.split('_');
      return ids[0] == request.auth.uid ? ids[1] : ids[0];
    }

    function areFriends(chatId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(chatOtherUid(chatId)));
    }

    function isBlocked(chatId) {
      return request.auth != null && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocks/$(chatOtherUid(chatId)))
        || exists(/databases/$(database)/documents/users/$(chatOtherUid(chatId))/blocks/$(request.auth.uid))
      );
    }

    function canChat(chatId) {
      return isChatParticipant(chatId) && areFriends(chatId) && !isBlocked(chatId);
    }

    function isGroupMember(groupId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    // Query-dostu: memberIds alaninda uid (array-contains ile uyumlu)
    function uidInGroupMemberIds(groupId) {
      return request.auth != null
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
    }

    function canAccessGroup(groupId) {
      return isGroupMember(groupId) || uidInGroupMemberIds(groupId);
    }

    match /friendCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'surname', 'avatar', 'about', 'online', 'lastSeen', 'lastActive', 'pushToken', 'friendCode', 'privacy']);

      match /userChats/{chatPartnerId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && (request.auth.uid == userId || request.auth.uid == chatPartnerId);
      }

      match /friendRequests/{fromUid} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == fromUid
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid == userId
          && request.resource.data.status == 'pending';
        allow update, delete: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == fromUid);
      }

      match /sentRequests/{toUid} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.toUid == toUid;
        allow update, delete: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == toUid);
      }

      match /friends/{friendUid} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, delete: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == friendUid);
        allow update: if false;
      }

      match /blocks/{blockedUid} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /starredMessages/{messageId} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /mutedChats/{friendId} {
        allow read: if request.auth != null;
        allow create, update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /chats/{chatId} {
      allow read, write: if canChat(chatId);

      match /messages/{messageId} {
        allow read: if canChat(chatId);

        allow create: if canChat(chatId)
          && request.resource.data.senderId == request.auth.uid;

        allow update: if canChat(chatId) && (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'deliveredAt', 'readAt'])
          ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reactions'])
          ||
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['deletedFor'])
          ||
          (resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['isDeleted', 'text']))
          ||
          (resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text', 'editedAt']))
        );

        allow delete: if false;
      }
    }

    match /groups/{groupId} {
      // Liste sorgusu: memberIds array-contains ile ayni kosul sart
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if canAccessGroup(groupId);
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && resource.data.createdBy == request.auth.uid;

      match /members/{memberId} {
        allow read: if canAccessGroup(groupId);
        allow write: if request.auth != null && (
          request.auth.uid == memberId
          || canAccessGroup(groupId)
        );
      }

      match /messages/{messageId} {
        allow read: if canAccessGroup(groupId);
        allow create: if canAccessGroup(groupId)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if canAccessGroup(groupId);
        allow delete: if false;
      }
    }

    match /calls/{callId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);
      allow create: if request.auth != null && request.auth.uid == request.resource.data.callerId;
      allow update: if request.auth != null && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);
      allow delete: if false;
    }

    match /statuses/{statusId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }
  }
}
