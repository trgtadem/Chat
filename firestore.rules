rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      // Giriş yapmış herhangi bir kullanıcı, kullanıcı listesini okuyabilir.
      allow read: if request.auth != null;

      // Bir kullanıcı sadece kendi belgesini oluşturabilir/yazabilir/güncelleyebilir.
      // Yeni kullanıcı kaydı için: authenticated kullanıcı kendi belgesini oluşturabilir
      allow create: if request.auth != null && request.auth.uid == userId;
      // Mevcut belgeleri güncelleme: sadece kendi belgesini güncelleyebilir
      allow update: if request.auth != null && request.auth.uid == userId;
      // Silme: sadece kendi belgesini silebilir (opsiyonel)
      allow delete: if request.auth != null && request.auth.uid == userId;

      // New rule for userChats subcollection
      match /userChats/{chatPartnerId} { // Renamed friendId to chatPartnerId for clarity
        // A user can only read their own 'userChats' subcollection
        allow read: if request.auth.uid == userId;
        // A user can write to their own userChats (userId == request.auth.uid)
        // OR a user can write to another user's userChats *if they are the chat partner* (chatPartnerId == request.auth.uid)
        allow write: if request.auth.uid == userId || request.auth.uid == chatPartnerId;
      }
    }

    match /chats/{chatId} {
      // Kullanıcıların dahil oldukları sohbetleri ve mesajları okumasına/yazmasına izin ver
      allow read, write: if request.auth.uid in chatId.split('_');

      match /messages/{messageId} {
        allow read, write: if request.auth.uid in chatId.split('_');
      }
    }
  }
}
