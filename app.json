{
  "expo": {
    "name": "Chat",
    "slug": "KOBAY",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/adaptive-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Arkadaş eklemek ve görüntülü arama için kamera erişimi gerekir.",
        "NSMicrophoneUsageDescription": "Sesli mesaj ve arama için mikrofon erişimi gerekir."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.adem_t.MyGameApp",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "23b216cc-6077-4732-958a-e9eb73417cf6"
      },
      "zego": {
        "appID": 0,
        "appSign": ""
      }
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "Sesli mesaj göndermek için mikrofon erişimi gerekir."
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#3B82F6",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Arkadaş eklemek için QR kod taramak üzere kamera erişimi gerekir."
        }
      ]
    ]
  }
}